# ──────────────────────────────────────────────────────────
#  banbu-stocktrading-korea — 환경변수 템플릿
#  실제 값은 이 파일을 복사해 `.env`로 만들어 채운다.
#    cp .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
#  .env 는 .gitignore 로 제외되어 절대 커밋되지 않는다.
# ──────────────────────────────────────────────────────────

# ── 한국투자증권 KIS OpenAPI ─────────────────────────────
# KIS_USE_MOCK=true 이면 모의투자(KIS_BASE_URL), false 이면 실전(KIS_REAL_URL).
# 기본값은 반드시 모의투자(true). 실전 전환은 명시적 의사결정 단계에서만.
KIS_USE_MOCK=true

KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_MOCK_APPKEY=
KIS_MOCK_APPSECRET=
KIS_MOCK_CANO=

# 실제투자 설정
KIS_REAL_URL=https://openapi.koreainvestment.com:9443
KIS_REAL_APPKEY=
KIS_REAL_APPSECRET=
KIS_REAL_CANO=

KIS_ACNT_PRDT_CD=01
TR_ID=VTTC8434R

# ── Supabase (PostgreSQL) ────────────────────────────────
SUPABASE_URL_KOREA=
# 서버 전용 — service_role 키(RLS 우회). 절대 외부 노출 금지.
SUPABASE_KEY_KOREA=
# Kaggle 노트북에 평문 주입되는 키 — anon 키를 넣는다(sql/013 RLS 로 최소 권한만 허용).
# ⚠ 여기에 service_role 을 넣으면 전권 키가 Kaggle 에 올라간다. 미설정 시 ML push 거부.
SUPABASE_KAGGLE_KEY=

# ── 거시지표 ─────────────────────────────────────────────
ECOS_API_KEY=

# ── LLM / 알림 ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Kaggle (ML 학습용, 이후 Step 4에서 사용) ─────────────
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
KAGGLE_KERNEL_SLUG=stock-prediction-korea
KAGGLE_NOTEBOOK_DIR=kaggle_notebook

# ── 기능 플래그 ──────────────────────────────────────────
USE_SCORING_V2=true
FRED_API_KEY=


COLLECT_ON_STARTUP=true


# Slack 알림 (비어있으면 알림 비활성)
SLACK_WEBHOOK_URL=
SLACK_NOTIFY_LEVEL=info   # info / warn / error (이 레벨 이상만 발송)

# ── 스케줄러 (시각은 전부 KST HH:MM) ─────────────────────
# 개발(reload) 중엔 false 권장 — 재기동마다 기동 만회(catchup)가 파이프라인을 돌 수 있음.
SCHEDULER_ENABLED=true
# 일일 파이프라인(수집→ML→매수결정). ⚠ 06:00 이전 금지 권장 — 겨울 미국장 마감(KST 06:00)과
# 겹치면 T-1 VIX·미국지수가 전전일 값으로 고착됨(core/config.py 주석 참조).
SCHEDULE_PIPELINE_TIME=07:00
# ⚠ true 금지 권장: 새벽엔 당일 시세가 없어 전일값 ffill 가짜 당일 행이 저장·고착됨(config.py 주석)
SCHEDULE_PIPELINE_FORCE_MARKET=false
SCHEDULE_BUY_TIME=10:00           # 매수 집행(장 시작 1시간 후)
SCHEDULE_SELL_INTERVAL_SEC=60     # 장중 매도 감시 주기(초)
SCHEDULE_RECONCILE_TIME=15:40     # 장 마감 후 체결 정합성 동기화